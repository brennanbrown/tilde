[200~# Basic Info
global_title="~brennan's weblog"
global_description="Queer Métis writer & web developer"
global_author="brennan"
global_author_url="https://brennan.day"
global_author_email="mail@brennanbrown.ca"

# URLs
global_url="https://tilde.club/~brennan/blog"
global_base_url="https://tilde.club/~brennan"

# Blog Settings
global_license="CC by-sa"
global_feedburner=""

# Display Options
cut_do="cut"                    # "cut" to show excerpts, leave blank for full posts
cut_tags="yes"                  # "yes" or "no" - show tags on index for cut articles
cut_line='<hr ?\/?>'           # HTML/markdown line where to cut (default is <hr>)

# RSS Feed
blog_feed="feed.rss"
number_of_feed_articles="10"

# Date Format
date_format="%B %d, %Y"        # Example: "January 20, 2026"
date_format_full="%B %d, %Y %H:%M:%S %Z"
date_format_timestamp="%Y%m%d%H%M.%S"
date_allposts_header="%B %Y"

# Language/Locale
date_locale=""                 # Leave empty for system default

# Markdown
markdown_bin="markdown"        # Path to markdown processor

# Template Strings (for customizing text)
template_tags_line_header="This post is tagged:"
template_twitter_comment="&lt;!-- Send tweets to @yourhandle --&gt;"
template_comments_title="Comments"

# Static Files
non_blogpost_files=()          # Array of files to ignore, e.g. ("about.html" "contact.html")

# CSS
css_include="custom.css"                 # Path to custom CSS file

# Header/Footer files
body_begin_file=""             # HTML file to include at beginning of body
body_end_file=""               # HTML file to include at end of body

# Conversion
convert_filename="yes"         # "yes" to sanitize filenames, "no" to keep as-is

# Disqus comments (if you use them)
global_disqus_username=""

# Twitter/Social
global_twitter_username=""
twitter_card_image=""

# Google Analytics
global_analytics=""

# Permalink style
permalink_style="full"         # "full" or "short"
